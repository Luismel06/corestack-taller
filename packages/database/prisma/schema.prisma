model Tenant {
  id                         String                      @id @default(cuid())
  name                       String
  commercialName             String?
  legalName                  String?
  slug                       String                      @unique
  rnc                        String?
  email                      String?
  phone                      String?
  address                    String?
  status                     TenantStatus                @default(ACTIVE)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  branding                   CompanyBranding?
  memberships                Membership[]
  customers                  Customer[]
  categories                 ProductCategory[]
  products                   Product[]
  inventoryMovements         InventoryMovement[]
  warehouseStocks            WarehouseStock[]
  warehouseMovements         WarehouseMovement[]
  invoices                   Invoice[]
  payments                   Payment[]
  electronicDocuments        ElectronicDocument[]
  auditLogs                  AuditLog[]
  employeeProfiles           EmployeeProfile[]
  cashRegisters              CashRegister[]
  cashSessions               CashSession[]
  cashMovements              CashMovement[]
  employeeActivityLogs       EmployeeActivityLog[]
  salesOrders                SalesOrder[]
  returnRequests             ReturnRequest[]
  fiscalSequences            FiscalSequence[]
  importBatches              ImportBatch[]
  suppliers                  Supplier[]
  supplierProducts           SupplierProduct[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderItems         PurchaseOrderItem[]
  purchaseOrderEvents        PurchaseOrderEvent[]
  supplierInvoices           SupplierInvoice[]
  supplierInvoiceItems       SupplierInvoiceItem[]
  supplierInvoiceAttachments SupplierInvoiceAttachment[]
  supplierPayments           SupplierPayment[]
  goodsReceipts              GoodsReceipt[]
  goodsReceiptItems          GoodsReceiptItem[]
  creditSaleApprovals        CreditSaleApproval[]
  mobileOcrCaptureSessions   MobileOcrCaptureSession[]
  vehicles                   WorkshopVehicle[]
  workshopTickets            WorkshopTicket[]
  workshopServices           WorkshopService[]
  workshopAppointments       WorkshopAppointment[]
  workshopReceptions         WorkshopReception[]
  workshopQualityChecks      WorkshopQualityCheck[]
  workshopDeliveries         WorkshopDelivery[]
  workshopInspections        WorkshopInspection[]
  workshopInspectionItems    WorkshopInspectionItem[]
  workshopTaskTimeEntries    WorkshopTaskTimeEntry[]
  workshopQuoteVersions      WorkshopQuoteVersion[]
  workshopBays               WorkshopBay[]
  workshopChangeOrders       WorkshopChangeOrder[]
  workshopTicketStatusEvents WorkshopTicketStatusEvent[]

  @@index([status])
  @@index([createdAt])
}

model CompanyBranding {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  logoUrl       String?
  primaryColor  String?
  accentColor   String?
  loginTitle    String?
  loginSubtitle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                                  String                      @id @default(cuid())
  email                               String                      @unique
  name                                String
  phone                               String?
  passwordHash                        String?
  status                              UserStatus                  @default(ACTIVE)
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @updatedAt
  memberships                         Membership[]
  auditLogs                           AuditLog[]
  employeeProfiles                    EmployeeProfile[]
  invoicesIssued                      Invoice[]                   @relation("InvoiceIssuedBy")
  inventoryMovementsCreated           InventoryMovement[]         @relation("InventoryMovementCreatedBy")
  warehouseMovementsCreated           WarehouseMovement[]         @relation("WarehouseMovementCreatedBy")
  payments                            Payment[]
  salesOrdersCreated                  SalesOrder[]                @relation("SalesOrderCreatedBy")
  salesOrdersCompleted                SalesOrder[]                @relation("SalesOrderCompletedBy")
  salesOrdersClaimed                  SalesOrder[]                @relation("SalesOrderClaimedBy")
  cashSessionsOpened                  CashSession[]               @relation("CashSessionOpenedBy")
  cashSessionsClosed                  CashSession[]               @relation("CashSessionClosedBy")
  cashMovements                       CashMovement[]
  employeeActivityLogs                EmployeeActivityLog[]
  importBatches                       ImportBatch[]
  returnRequestsRequested             ReturnRequest[]             @relation("ReturnRequestRequestedBy")
  returnRequestsApproved              ReturnRequest[]             @relation("ReturnRequestApprovedBy")
  returnRequestsRejected              ReturnRequest[]             @relation("ReturnRequestRejectedBy")
  customersCreditEnabled              Customer[]                  @relation("CustomerCreditEnabledBy")
  suppliersCreated                    Supplier[]                  @relation("SupplierCreatedBy")
  suppliersUpdated                    Supplier[]                  @relation("SupplierUpdatedBy")
  suppliersDeactivated                Supplier[]                  @relation("SupplierDeactivatedBy")
  supplierProductsCreated             SupplierProduct[]           @relation("SupplierProductCreatedBy")
  supplierProductsUpdated             SupplierProduct[]           @relation("SupplierProductUpdatedBy")
  purchaseOrdersCreated               PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  purchaseOrdersRequested             PurchaseOrder[]             @relation("PurchaseOrderRequestedBy")
  purchaseOrdersReviewed              PurchaseOrder[]             @relation("PurchaseOrderReviewedBy")
  purchaseOrdersApproved              PurchaseOrder[]             @relation("PurchaseOrderApprovedBy")
  purchaseOrdersIssued                PurchaseOrder[]             @relation("PurchaseOrderIssuedBy")
  purchaseOrdersPaused                PurchaseOrder[]             @relation("PurchaseOrderPausedBy")
  purchaseOrdersCancelled             PurchaseOrder[]             @relation("PurchaseOrderCancelledBy")
  purchaseOrderEvents                 PurchaseOrderEvent[]
  supplierInvoicesCreated             SupplierInvoice[]           @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesUpdated             SupplierInvoice[]           @relation("SupplierInvoiceUpdatedBy")
  supplierInvoicesCancelled           SupplierInvoice[]           @relation("SupplierInvoiceCancelledBy")
  supplierInvoiceAttachmentsUploaded  SupplierInvoiceAttachment[] @relation("SupplierInvoiceAttachmentUploadedBy")
  supplierInvoiceAttachmentsConfirmed SupplierInvoiceAttachment[] @relation("SupplierInvoiceAttachmentConfirmedBy")
  supplierPaymentsCreated             SupplierPayment[]           @relation("SupplierPaymentCreatedBy")
  supplierPaymentsCancelled           SupplierPayment[]           @relation("SupplierPaymentCancelledBy")
  goodsReceiptsCreated                GoodsReceipt[]              @relation("GoodsReceiptCreatedBy")
  goodsReceiptsConfirmed              GoodsReceipt[]              @relation("GoodsReceiptConfirmedBy")
  goodsReceiptsReversed               GoodsReceipt[]              @relation("GoodsReceiptReversedBy")
  goodsReceiptsCancelled              GoodsReceipt[]              @relation("GoodsReceiptCancelledBy")
  creditSaleApprovalsRequested        CreditSaleApproval[]        @relation("CreditSaleApprovalRequestedBy")
  creditSaleApprovalsApproved         CreditSaleApproval[]        @relation("CreditSaleApprovalApprovedBy")
  creditSaleApprovalsRejected         CreditSaleApproval[]        @relation("CreditSaleApprovalRejectedBy")
  creditSaleApprovalsCancelled        CreditSaleApproval[]        @relation("CreditSaleApprovalCancelledBy")
  paymentsCancelled                   Payment[]                   @relation("PaymentCancelledBy")
  mobileOcrCaptureSessionsCreated     MobileOcrCaptureSession[]   @relation("MobileOcrCaptureCreatedBy")
  workshopTicketsCreated              WorkshopTicket[]            @relation("WorkshopTicketCreatedBy")
  workshopAppointmentsCreated         WorkshopAppointment[]       @relation("WorkshopAppointmentCreatedBy")
  workshopReceptionsCreated           WorkshopReception[]         @relation("WorkshopReceptionCreatedBy")
  workshopQualityChecksCreated        WorkshopQualityCheck[]      @relation("WorkshopQualityCheckCreatedBy")
  workshopDeliveriesCreated           WorkshopDelivery[]          @relation("WorkshopDeliveryCreatedBy")
  workshopInspectionsCreated          WorkshopInspection[]        @relation("WorkshopInspectionCreatedBy")
  workshopTaskTimeEntriesCreated      WorkshopTaskTimeEntry[]     @relation("WorkshopTaskTimeEntryCreatedBy")
  workshopQuoteVersionsCreated        WorkshopQuoteVersion[]      @relation("WorkshopQuoteVersionCreatedBy")
  workshopChangeOrdersCreated         WorkshopChangeOrder[]       @relation("WorkshopChangeOrderCreatedBy")
  workshopChangeOrdersResponded       WorkshopChangeOrder[]       @relation("WorkshopChangeOrderRespondedBy")
  workshopTicketStatusEventsCreated   WorkshopTicketStatusEvent[] @relation("WorkshopTicketStatusEventCreatedBy")

  @@index([status])
  @@index([createdAt])
}

model Membership {
  id                       String           @id @default(cuid())
  userId                   String
  tenantId                 String
  role                     Role
  status                   MembershipStatus @default(ACTIVE)
  canUsePos                Boolean          @default(false)
  canOpenCashSession       Boolean          @default(false)
  canCloseCashSession      Boolean          @default(false)
  canApplyDiscount         Boolean          @default(false)
  canCancelInvoice         Boolean          @default(false)
  canVoidInvoice           Boolean          @default(false)
  canAdjustInventory       Boolean          @default(false)
  canManageProducts        Boolean          @default(false)
  permissionOverrides      Json?
  canManageEmployees       Boolean          @default(false)
  canViewReports           Boolean          @default(false)
  canManageFiscalSequences Boolean          @default(false)
  canViewCashLogs          Boolean          @default(false)
  canReprintReceipt        Boolean          @default(false)
  canTakeOrders            Boolean          @default(false)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId])
}

model Customer {
  id                   String                @id @default(cuid())
  tenantId             String
  name                 String
  documentType         DocumentType
  documentNumber       String?
  email                String?
  phone                String?
  address              String?
  status               CustomerStatus        @default(ACTIVE)
  creditEnabled        Boolean               @default(false)
  creditLimit          Decimal               @default(0) @db.Decimal(14, 2)
  creditBalance        Decimal               @default(0) @db.Decimal(14, 2)
  creditTermDays       Int                   @default(30)
  creditStatus         CustomerCreditStatus  @default(BLOCKED)
  creditEnabledAt      DateTime?
  creditEnabledById    String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditEnabledBy      User?                 @relation("CustomerCreditEnabledBy", fields: [creditEnabledById], references: [id], onDelete: SetNull)
  invoices             Invoice[]
  salesOrders          SalesOrder[]
  creditSaleApprovals  CreditSaleApproval[]
  vehicles             WorkshopVehicle[]
  workshopTickets      WorkshopTicket[]
  workshopAppointments WorkshopAppointment[]

  @@unique([tenantId, documentType, documentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, creditEnabled, creditStatus])
  @@index([creditEnabledById])
  @@index([createdAt])
}

model ProductCategory {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([createdAt])
}

model Product {
  id                       String                      @id @default(cuid())
  tenantId                 String
  categoryId               String?
  name                     String
  sku                      String?
  barcode                  String?
  barcodeType              BarcodeType?
  generatedBarcode         Boolean                     @default(false)
  barcodeLabelPrintedAt    DateTime?
  barcodeLabelPrintCount   Int                         @default(0)
  barcodeLastScannedAt     DateTime?
  barcodeCreatedById       String?
  description              String?
  imageUrl                 String?
  brand                    String?
  unit                     ProductUnit                 @default(UNIT)
  price                    Decimal                     @db.Decimal(12, 2)
  salePrice                Decimal                     @default(0) @db.Decimal(12, 2)
  cost                     Decimal?                    @db.Decimal(12, 2)
  costWithTax              Decimal?                    @db.Decimal(14, 2)
  margin                   Decimal?                    @db.Decimal(8, 4)
  taxCategory              TaxCategory                 @default(ITBIS_18)
  taxRate                  Decimal                     @default(0.18) @db.Decimal(5, 4)
  trackInventory           Boolean                     @default(true)
  inventoryDestination     ProductInventoryDestination @default(SALES_INVENTORY)
  stock                    Float                       @default(0)
  reservedStock            Float                       @default(0)
  minStock                 Float                       @default(0)
  status                   ProductStatus               @default(ACTIVE)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  tenant                   Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category                 ProductCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryMovements       InventoryMovement[]
  warehouseStocks          WarehouseStock[]
  warehouseMovements       WarehouseMovement[]
  invoiceItems             InvoiceItem[]
  salesOrderItems          SalesOrderItem[]
  returnRequestItems       ReturnRequestItem[]
  supplierProducts         SupplierProduct[]
  purchaseOrderItems       PurchaseOrderItem[]
  supplierInvoiceItems     SupplierInvoiceItem[]
  goodsReceiptItems        GoodsReceiptItem[]
  importRows               ImportBatchRow[]
  workshopTicketLines      WorkshopTicketLine[]
  workshopChangeOrderLines WorkshopChangeOrderLine[]
  workshopServiceProfile   WorkshopService?

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, inventoryDestination, status])
  @@index([tenantId, sku])
  @@index([tenantId, stock])
  @@index([createdAt])
}

model InventoryMovement {
  id                   String                @id @default(cuid())
  tenantId             String
  productId            String
  type                 InventoryMovementType
  quantity             Float
  previousStock        Float?
  newStock             Float?
  unitCost             Decimal?              @db.Decimal(12, 2)
  reason               String?
  reference            String?
  invoiceId            String?
  supplierInvoiceId    String?
  goodsReceiptId       String?
  workshopTicketLineId String?
  operationKey         String?
  createdById          String?
  createdAt            DateTime              @default(now())
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoice              Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  supplierInvoice      SupplierInvoice?      @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  goodsReceipt         GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  workshopTicketLine   WorkshopTicketLine?   @relation(fields: [workshopTicketLineId], references: [id], onDelete: Restrict)
  createdBy            User?                 @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, operationKey])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([invoiceId])
  @@index([supplierInvoiceId])
  @@index([goodsReceiptId])
  @@index([workshopTicketLineId])
  @@index([createdById])
}

model WarehouseStock {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  quantity  Float    @default(0)
  unitCost  Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, quantity])
}

model WarehouseMovement {
  id                String                @id @default(cuid())
  tenantId          String
  productId         String
  type              WarehouseMovementType
  quantity          Float
  previousQuantity  Float?
  newQuantity       Float?
  unitCost          Decimal?              @db.Decimal(12, 2)
  reason            String?
  reference         String?
  supplierInvoiceId String?
  goodsReceiptId    String?
  createdById       String?
  createdAt         DateTime              @default(now())
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy         User?                 @relation("WarehouseMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([goodsReceiptId])
  @@index([createdById])
}

model Invoice {
  id                   String                @id @default(cuid())
  checkoutKey          String?
  checkoutRequestHash  String?
  tenantId             String
  customerId           String?
  documentType         InvoiceDocumentType   @default(CONSUMER_02)
  invoiceNumber        String
  ncf                  String?
  eNcf                 String?
