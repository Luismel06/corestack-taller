# Local Docker PostgreSQL defaults. Replace when targeting Supabase.
DATABASE_URL="postgresql://corestack:corestack@localhost:5432/corestack_taller?schema=public"
DIRECT_URL="postgresql://corestack:corestack@localhost:5432/corestack_taller?schema=public"
# Target for the demo migration ONLY. Keep DATABASE_URL local until the copy is verified.
# Session pooler (port 5432) of a NEW project dedicated to this workshop demo.
SUPABASE_DEMO_DATABASE_URL=""
# Optional local database for workshop integration tests (each run uses its own temporary schema).
# WORKSHOP_TEST_DATABASE_URL="postgresql://corestack:corestack@localhost:5432/corestack_taller?schema=public"

# Supabase PostgreSQL placeholders for temporary managed DB usage.
# Encode special characters in the password, for example @ becomes %40.
# DATABASE_URL="postgresql://postgres.YOUR_WORKSHOP_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.YOUR_WORKSHOP_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require"

# Local Docker compose values.
POSTGRES_USER="corestack"
POSTGRES_PASSWORD="corestack"
POSTGRES_DB="corestack_taller"

# Backend auth. Never use Supabase JWT secret here. Production requires a unique
# value of at least 32 characters and refuses placeholders.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-corestack-secret"
JWT_EXPIRES_IN="8h"

# API / CORS.
API_PORT=4000
CORS_ORIGIN="http://localhost:3000,https://YOUR_FRONTEND_VERCEL_URL"
TRUST_PROXY=1
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_JSON_BODY_LIMIT="1mb"
API_FORM_BODY_LIMIT="1mb"

# Internal-only access control. Empty means no application-level IP restriction.
# Enforce the same policy at Vercel Firewall/Zero Trust in production.
# Use office/VPN static IPs or CIDR ranges, for example: "203.0.113.10,198.51.100.0/24"
INTERNAL_ALLOWED_IPS=""

# Frontend.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional base URL used when generating a QR to capture OCR from a phone.
# Leave empty in Vercel: the current HTTPS origin is detected automatically.
# For local mobile testing use a public HTTPS tunnel or preview URL, never an IP over HTTP.
NEXT_PUBLIC_APP_URL=""

# Envío desacoplado de cotizaciones, facturas y copias e-CF con Resend.
# RESEND_FROM debe usar un dominio verificado cuando se configure producción.
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_QUOTATION_TEMPLATE_ID=""
RESEND_INVOICE_TEMPLATE_ID=""
RESEND_ECF_TEMPLATE_ID=""

# Short-lived phone OCR handoff. These are backend-only rate-limit settings.
MOBILE_OCR_PUBLIC_RATE_LIMIT_WINDOW_MS=600000
MOBILE_OCR_PUBLIC_RATE_LIMIT_MAX=30

# Backend-only Supabase values. Never expose these with NEXT_PUBLIC_.
SUPABASE_URL="https://YOUR_WORKSHOP_PROJECT.supabase.co"
# Prefer SUPABASE_SERVICE_ROLE_KEY for Storage uploads. SUPABASE_SECRET_KEY is also supported.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_SECRET_KEY="replace-with-secret-key"
SUPABASE_JWKS_URL="https://YOUR_WORKSHOP_PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_PRODUCT_IMAGE_BUCKET="product-images"
